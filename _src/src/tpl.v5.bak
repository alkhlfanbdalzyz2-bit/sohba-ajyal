%%VWHTML%%
<div id="vp" hidden role="dialog" aria-modal="true" aria-label="مشغل الفيديو"><div class="vt"><button class="vx" type="button" data-vpx aria-label="إغلاق"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button><b></b></div><div class="vb"></div></div>

<script>
(function(){
"use strict";
function e(s){ return String(s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
var LOGO = 'assets/ajyal.webp', SHIELD = 'assets/shield.webp';
function store(k, v){ try { if (v === undefined) return JSON.parse(localStorage.getItem(k) || 'null'); localStorage.setItem(k, JSON.stringify(v)); } catch(_){ return null; } }
%%ICONS%%
I.home = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h5v-6h4v6h5V10"/></svg>';
I.shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l8 3v6c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10v-6z"/><path d="M9 12l2 2 4-4"/></svg>';
I.board = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 15v-3M12 15V9M17 15v-5"/></svg>';
I.flag = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4"/><path d="M5 4h11l-2 4 2 4H5"/></svg>';
I.film = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="5" width="19" height="14" rx="3"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/></svg>';

/* ===================== المحتوى =====================
   صورة:  { type:'img', src:'gal/اسم.jpg', th:'gal/اسم.webp' }
   فيديو قصير بالألبوم: { type:'video', src:'media/اسم.mp4', poster:'media/اسم.webp' }
   فيديو طويل (دروس/فلوقات): { t:'العنوان', d:'المدة', yt:'رمز يوتيوب' }  أو  { t:'العنوان', d:'المدة', src:'media/اسم.mp4', poster:'media/اسم.webp' }
   new:'2026-11-20' تطلع شارة «جديد» أسبوعين من هالتاريخ */
var DIR3 = [{ type:'img', src:'gal/p1.jpg', th:'gal/t1.webp' }, { type:'video', src:'media/v1.mp4', poster:'media/v1.webp' }];
for (var _g = 2; _g <= 107; _g++) DIR3.push({ type:'img', src:'gal/p'+_g+'.jpg', th:'gal/t'+_g+'.webp' });
for (var _v = 2; _v <= 14; _v++) DIR3.push({ type:'video', src:'media/v'+_v+'.mp4', poster:'media/v'+_v+'.webp' });

var COURSE = { id:'khutah', t:'كورس على خطاه', poster:'assets/khutah.webp', parts:[
  { id:'photos', t:'صور الكورس', s:'لحظات كورس على خطاه', icon:'pic', items:[] },
  { id:'halaqat', t:'لوحة حلقات القرآن', s:'درجات الحلقات كل أسبوع', icon:'board', items:[] },
  { id:'challenges', t:'لوحة تحديات الكورس', s:'أبطال التحديات', icon:'flag', items:[] }
]};
var PAST = [
  { id:'basira', t:'كورس على بصيرة', s:'صور الكورس', icon:'eye', c:'', items:[] },
  { id:'rattil', t:'كورس ورتّل', s:'صور الكورس', icon:'book', c:'b', items:[] },
  { id:'dir3', t:'الدرع الحصين', s:'صور وفيديو', icon:'shield', c:'g', cover:'assets/cv-dir3.webp', items:DIR3 }
];
var MORE = [
  { id:'group', t:'الصور الجماعية', s:'لقطات الصحبة', icon:'users', c:'b', cover:'assets/cv-group.webp', items:[] },
  { id:'designs', t:'تصاميم النادي', s:'تصاميم وبوسترات', icon:'pen', c:'', items:[] }
];
var VIDEOS = {
  lessons:{ t:'الدروس', s:'دروس الصحبة كاملة', items:[] },
  vlogs:{ t:'فلوقات الصحبة', s:'فلوقات طويلة للمشاهدة والاستمتاع', items:[] }
};
function albumById(id){ var L = PAST.concat(MORE).concat(COURSE.parts.map(function(p){ return { id:'khutah-'+p.id, t:p.t, s:p.s, icon:p.icon, items:p.items, course:true }; })); return L.filter(function(a){ return a.id===id; })[0]; }
function countOf(list, t){ return list.filter(function(m){ return m.type===t; }).length; }
function isNew(a){ if (!a.new) return false; var d = (Date.now() - new Date(a.new).getTime())/864e5; return d >= 0 && d < 14; }

%%AW%%

/* ===================== أجزاء ===================== */
function sh(k, t, p){ return '<div class="sh rv">'+(k?'<div class="k">'+k+'</div>':'')+'<h2>'+t+'</h2><span class="dots"></span>'+(p?'<p>'+p+'</p>':'')+'</div>'; }
function card(a, href){
  var has = a.items.length, st = isNew(a) ? '<span class="st new">جديد</span>' : has ? '<span class="st ok">'+countOf(a.items,'img')+' صورة</span>' : '<span class="st">قريباً</span>';
  return '<a class="card on '+(a.c||'')+'" href="'+href+'"><span class="shp"></span><span class="ic">'+I[a.icon]+'</span>'+st+'<b>'+a.t+'</b><small>'+a.s+'</small></a>';
}
function vcard(id, o){ var v = VIDEOS[id], n = v.items.length;
  return '<a class="vc'+(o?' o':'')+'" href="#/videos/'+id+'"><span class="shp"></span><span class="pl">'+I.play+'</span><span class="st">'+(n ? n+' فيديو' : 'قريباً')+'</span><b>'+v.t+'</b><small>'+v.s+'</small></a>'; }
function courseBlock(){
  return '<div class="course frame rv"><div class="ctop"><div class="arch"><img src="'+COURSE.poster+'" alt="كورس على خطاه ﷺ"><span class="sheen"></span></div>'+
    '<div><span class="tag"><i></i>الكورس الحالي</span><h2>كورس على خطاه <small>ﷺ</small></h2></div></div>'+
    '<div class="ctiles">'+COURSE.parts.map(function(p){ return '<a class="ct" href="#/khutah/'+p.id+'"><span class="ci">'+I[p.icon]+'</span><b>'+p.t+'</b><small>'+(p.items.length ? p.items.length+' صورة' : 'قريباً')+'</small></a>'; }).join('')+'</div></div>';
}
function row(o){
  return '<a class="cc '+(o.c||'')+(o.img?' has':'')+'" href="'+o.href+'">'+(o.img?'<span class="cbg" style="background-image:url('+o.img+')"></span>':'<span class="cic">'+o.ic+'</span>')+
    '<span class="ctx"><small class="ck">'+o.k+'</small><b>'+o.t+'</b><span class="cst'+(o.ok?' ok':'')+'">'+o.st+'</span></span><span class="cgo">'+(o.play?I.play:I.chevL)+'</span></a>';
}
function albRow(a, k){ var n = a.items.length; return row({ href:'#/album/'+a.id, ic:I[a.icon], img:a.cover, k:k, t:a.t, c:a.c, ok:n, st: isNew(a) ? 'جديد' : n ? countOf(a.items,'img')+' صورة'+(countOf(a.items,'video')?' · '+countOf(a.items,'video')+' فيديو':'') : 'قريباً' }); }
function vidRow(id, c){ var v = VIDEOS[id], n = v.items.length; return row({ href:'#/videos/'+id, ic:I.film, k:'فيديو', t:v.t, c:c, ok:n, play:1, st: n ? n+' فيديو' : 'قريباً' }); }
function library(parts){
  parts = parts || ['v','p','m'];
  var g = { v: vidRow('lessons','b')+vidRow('vlogs'), p: PAST.map(function(a){ return albRow(a,'كورس سابق'); }).join(''), m: MORE.map(function(a){ return albRow(a,'ألبوم'); }).join('') };
  return '<div class="ccs stg">'+parts.map(function(k){ return g[k]; }).join('')+'</div>';
}
function home(){
  return '<div class="page">'+
  '<section class="cine"><span class="cbk" style="background-image:url(assets/hero.webp)"></span><span class="cgl"></span>'+
    '<div class="wrap ci2"><span class="seal"><img src="'+LOGO+'" alt="شعار نادي أجيال"></span>'+
    '<h1>صحبة <span>أجيال</span></h1><div class="sub">نادي أجيال القرآن الكريم · القرين</div>'+
    '<div class="tags"><span>قرآني</span><span>تربوي</span><span>ترفيهي</span></div>'+
    '<figure class="grp"><img src="assets/hero.webp" alt="شباب صحبة أجيال" fetchpriority="high"></figure></div></section>'+
  '<section class="band"><div class="wrap">'+courseBlock()+'</div></section>'+
  '<section class="band"><div class="wrap">'+sh('','معرض الصحبة')+library()+'</div></section>'+
  '<section class="band"><div class="wrap">'+sh('','إنجازاتنا','والقادم أفضل بإذن الله')+
    '<div class="ccs stg">'+row({ href:'#/awards', img:'assets/cv-awards.webp', k:'الدرع الحصين ١٠ · المركز الثالث', t:'منصة التتويج', c:'g', ok:1, st:AW.length+' تتويج' })+'</div>'+
    '<div class="stats rv"><div><b class="cnt" data-to="'+AW.length+'">0</b><span>تتويج</span></div><div><b class="cnt" data-to="46">0</b><span>مشارك</span></div><div><b class="cnt" data-to="'+countOf(DIR3,'img')+'">0</b><span>صورة</span></div></div>'+
  '</div></section>'+
  '<section class="band" id="about"><div class="wrap">'+sh('','من نحن')+
    '<div class="mission frame rv"><span class="lbl">رسالتنا</span><h2>نحو بناء جيل <em>صالح بنفسه</em><br>مُصلح لغيره</h2>'+
    '<div class="tags"><span>قرآني</span><span>تربوي</span><span>ترفيهي</span></div><p>للشباب من 14 إلى 17 سنة · القرين</p></div>'+
  '</div></section></div>';
}
function ptop(icon, small, title, p, img){
  return '<section class="ptop"><span class="shp"></span><div class="wrap"><span class="pi">'+(img?'<img src="'+img+'" alt="">':I[icon])+'</span><div><small>'+small+'</small><h1>'+title+'</h1>'+(p?'<p>'+p+'</p>':'')+'</div></div></section>';
}
function emptyBox(t){ return '<div class="empty rv"><span class="shp fade"></span><div class="e1"><img src="'+LOGO+'" alt=""></div><b>قريباً</b><span>'+(t||'بننزلها قريباً بإذن الله')+'</span></div>'; }
function homeBtn(){ return '<a class="homebtn" href="#/">'+I.home+'الرجوع للرئيسية</a>'; }
function grid(a){
  return '<div class="ggrid">'+a.items.map(function(m, i){
    var inner = m.type==='video' ? '<video src="'+m.src+'#t=0.5" '+(m.poster?'poster="'+m.poster+'" ':'')+'muted playsinline preload="none"></video><span class="gp">'+I.play+'</span>' : '<img src="'+(m.th||m.src)+'" alt=""'+(i>5?' loading="lazy"':'')+'>';
    return '<button type="button" class="gi'+(i===0?' f1':'')+'" data-open="'+a.id+':'+i+'" aria-label="عرض">'+inner+'</button>';
  }).join('')+'</div>';
}
function albumPage(id){
  var a = albumById(id); if (!a) return null;
  var sub = a.items.length ? countOf(a.items,'img')+' صورة'+(countOf(a.items,'video')?' · '+countOf(a.items,'video')+' فيديو':'') : a.s;
  return '<div class="page">'+ptop(a.icon, a.course ? 'كورس على خطاه ﷺ' : 'المعرض', a.t, sub)+
    '<section class="band" style="padding-top:16px"><div class="wrap">'+(a.items.length ? grid(a) : emptyBox())+homeBtn()+'</div></section></div>';
}
function coursePage(){
  return '<div class="page">'+ptop('book','الكورس الحالي','كورس على خطاه ﷺ','',COURSE.poster)+'<section class="band" style="padding-top:16px"><div class="wrap">'+courseBlock()+homeBtn()+'</div></section></div>';
}
function galleryPage(){
  return '<div class="page">'+ptop('pic','صحبة أجيال','المعرض','الكورسات السابقة وصور الصحبة')+'<section class="band" style="padding-top:16px"><div class="wrap">'+library(['p','m'])+homeBtn()+'</div></section></div>';
}
function videosHub(){
  return '<div class="page">'+ptop('film','صحبة أجيال','الفيديو','الدروس وفلوقات الصحبة')+'<section class="band" style="padding-top:16px"><div class="wrap">'+library(['v'])+homeBtn()+'</div></section></div>';
}
function videoPage(id){
  var v = VIDEOS[id]; if (!v) return null;
  var list = v.items.length ? '<div class="vlist stg">'+v.items.map(function(x, i){
      var th = x.poster || (x.yt ? 'https://i.ytimg.com/vi/'+x.yt+'/hqdefault.jpg' : LOGO), pos = store('vt:'+id+':'+i) || 0;
      return '<button type="button" class="vi" data-vid="'+id+':'+i+'"><span class="th"><img src="'+th+'" alt="" loading="lazy"><i>'+I.play+'</i></span><span style="flex:1;min-width:0"><b>'+e(x.t)+'</b><small>'+(x.d||'')+'</small>'+(pos && x.dur ? '<span class="pr"><span style="width:'+Math.min(100, pos/x.dur*100)+'%"></span></span>' : '')+'</span></button>';
    }).join('')+'</div>' : emptyBox('بننزل '+v.t+' قريباً بإذن الله');
  return '<div class="page">'+ptop('film','الفيديو',v.t,v.s)+'<section class="band" style="padding-top:16px"><div class="wrap">'+list+homeBtn()+'</div></section></div>';
}
function awCard(a, i){
  return '<article class="aw'+(a.big?' big':'')+'"><button type="button" class="ph" data-aw="'+i+'" aria-label="عرض الصورة"><img src="gal/t'+a.p+'.webp" alt="" loading="lazy">'+medal(a.r)+'</button>'+
    '<div class="bd"><h3>'+e(a.t)+'</h3><ul>'+a.n.map(function(x){ var k = x.split(': '); return '<li>'+(k[1]?'<small>'+e(k[0])+'</small>'+e(k[1]):e(x))+'</li>'; }).join('')+'</ul></div></article>';
}
function awardsPage(){
  var h = '<div class="page">'+ptop('trophy','الدرع الحصين ١٠','منصة التتويج',AW.length+' تتويج لأجيال')+'<section class="band" style="padding-top:16px"><div class="wrap"><div class="aw-grid stg">'+AW.map(function(a,i){ return a.big ? awCard(a,i) : ''; }).join('')+'</div></div></section>';
  [[1,'المراكز الأولى'],[2,'المراكز الثانية'],[3,'المراكز الثالثة'],[0,'التكريم']].forEach(function(g){
    var L = []; AW.forEach(function(a,i){ if (a.r===g[0] && !a.big) L.push(awCard(a,i)); });
    if (L.length) h += '<section class="band" style="padding-top:0"><div class="wrap"><div class="aw-gh">'+medal(g[0])+'<h2>'+g[1]+'</h2></div><div class="aw-grid stg">'+L.join('')+'</div></div></section>';
  });
  return h + '<section class="band" style="padding-top:0"><div class="wrap">'+homeBtn()+'</div></section></div>';
}

%%VIEWER%%
/* ===================== مشغل الفيديو الطويل ===================== */
var VPcur = null;
function vpOpen(id, i){
  var x = VIDEOS[id].items[i], d = document.getElementById('vp'), b = d.querySelector('.vb');
  d.querySelector('.vt b').textContent = x.t;
  if (x.yt) b.innerHTML = '<iframe src="https://www.youtube-nocookie.com/embed/'+encodeURIComponent(x.yt)+'?autoplay=1&rel=0&playsinline=1&modestbranding=1" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen title="'+e(x.t)+'"></iframe>';
  else {
    b.innerHTML = '<video src="'+x.src+'" '+(x.poster?'poster="'+x.poster+'" ':'')+'controls playsinline autoplay preload="metadata" x-webkit-airplay="allow"></video>';
    var v = b.querySelector('video'), k = 'vt:'+id+':'+i, pos = store(k);
    v.addEventListener('loadedmetadata', function(){ if (pos && pos < v.duration - 10) v.currentTime = pos; x.dur = v.duration; });
    v.addEventListener('timeupdate', function(){ if (Math.floor(v.currentTime) % 5 === 0) store(k, v.currentTime); });
  }
  VPcur = id; d.hidden = false; document.documentElement.classList.add('noscroll');
}
function vpClose(){ var d = document.getElementById('vp'); d.hidden = true; d.querySelector('.vb').innerHTML = ''; document.documentElement.classList.remove('noscroll'); }

/* ===================== الوضع ===================== */
var RM = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
function setTheme(t){
  function apply(){ document.documentElement.setAttribute('data-theme', t); var m = document.getElementById('tc'); if (m) m.content = t==='light' ? '#f6f0e4' : '#031635'; }
  try { localStorage.setItem('ajyal-theme', t); } catch(_){}
  if (document.startViewTransition && !RM) document.startViewTransition(apply); else apply();
}

/* ===================== الأحداث ===================== */
document.addEventListener('click', function(ev){
  var t = ev.target; if (!t.closest) return;
  if (t.closest('#themeB')){ setTheme(document.documentElement.getAttribute('data-theme')==='light' ? 'dark' : 'light'); return; }
  var hr = t.closest('[data-href]'); if (hr){ location.hash = hr.getAttribute('data-href'); return; }
  var op = t.closest('[data-open]'); if (op){ var p = op.getAttribute('data-open').split(':'); vwOpenList(albumById(p[0]).items, +p[1]); return; }
  var aw = t.closest('[data-aw]'); if (aw){ vwOpenList(AW.map(function(a){ return { type:'img', src:'gal/p'+a.p+'.jpg' }; }), +aw.getAttribute('data-aw')); return; }
  var vd = t.closest('[data-vid]'); if (vd){ var q = vd.getAttribute('data-vid').split(':'); vpOpen(q[0], +q[1]); return; }
  if (t.closest('[data-vpx]')){ vpClose(); return; }
  var vw = document.getElementById('vw');
  if (!vw.hidden){ if (t.closest('[data-vdl]')){ vwDownload(); return; } if (t.closest('[data-vclose]')){ vwClose(); return; } if (t.closest('[data-vprev]')){ vwStep(-1); return; } if (t.closest('[data-vnext]')){ vwStep(1); return; } if (Date.now() < VZ.quiet || VZ.s > 1.01) return; if (t === vw || t.classList.contains('vw-st')) vwClose(); }
});
document.addEventListener('keydown', function(ev){
  if (!document.getElementById('vp').hidden && ev.key==='Escape'){ vpClose(); return; }
  var vw = document.getElementById('vw');
  if (!vw.hidden){ if (ev.key==='Escape') vwClose(); if (ev.key==='ArrowLeft') vwStep(1); if (ev.key==='ArrowRight') vwStep(-1); return; }
  if ((ev.key==='Enter' || ev.key===' ') && ev.target.matches && ev.target.matches('[role="button"][data-href]')){ ev.preventDefault(); location.hash = ev.target.getAttribute('data-href'); }
});

/* ===================== مؤثرات ===================== */
var RV = null;
function count(el){
  if (el.dataset.done) return; el.dataset.done = '1'; var to = +el.getAttribute('data-to');
  if (RM){ el.textContent = to; return; }
  var t0 = performance.now(); (function f(t){ var k = Math.min(1,(t-t0)/1300); el.textContent = Math.round(to*(1-Math.pow(1-k,3))); if (k<1) requestAnimationFrame(f); })(t0);
}
function reveal(){
  var els = document.querySelectorAll('#app .rv, #app .stg');
  if (RM || !('IntersectionObserver' in window)){ Array.prototype.forEach.call(els, function(x){ x.classList.add('in'); }); Array.prototype.forEach.call(document.querySelectorAll('#app .cnt'), count); return; }
  if (RV) RV.disconnect();
  RV = new IntersectionObserver(function(es){ es.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('in'); RV.unobserve(en.target); Array.prototype.forEach.call(en.target.querySelectorAll('.cnt'), count); } }); }, { rootMargin:'0px 0px -6% 0px', threshold:.04 });
  Array.prototype.forEach.call(els, function(x){ RV.observe(x); });
}
(function(){ var bar = document.querySelector('.sprog'), raf = 0;
  window.addEventListener('scroll', function(){ if (raf) return; raf = requestAnimationFrame(function(){ raf = 0; var h = document.documentElement.scrollHeight - innerHeight; bar.style.transform = 'scaleX('+(h>0 ? Math.min(1, scrollY/h) : 0)+')'; }); }, { passive:true });
})();

/* ===================== التنقل ===================== */
var app = document.getElementById('app'), curRoute = null;
function routeNow(){
  var id = (location.hash||'').replace(/^#\/?/,''), html = null, title = 'صحبة أجيال القرآن الكريم', tab = '';
  if (id === 'awards'){ html = awardsPage(); title = 'منصة التتويج'; }
  else if (id === 'khutah'){ html = coursePage(); title = 'كورس على خطاه ﷺ'; tab = 'khutah'; }
  else if (id.indexOf('khutah/') === 0){ html = albumPage('khutah-'+id.slice(7)); tab = 'khutah'; if (html) title = albumById('khutah-'+id.slice(7)).t; }
  else if (id === 'gallery'){ html = galleryPage(); title = 'المعرض'; tab = 'gallery'; }
  else if (id.indexOf('album/') === 0){ html = albumPage(id.slice(6)); tab = 'gallery'; if (html) title = albumById(id.slice(6)).t; }
  else if (id === 'videos'){ html = videosHub(); title = 'الفيديو'; tab = 'videos'; }
  else if (id.indexOf('videos/') === 0){ html = videoPage(id.slice(7)); tab = 'videos'; if (html) title = VIDEOS[id.slice(7)].t; }
  if (!html){ id = ''; html = home(); if (location.hash && location.hash !== '#/' && history.replaceState) history.replaceState(null, '', location.pathname + location.search); }
  curRoute = id; app.innerHTML = html; document.title = id ? title+' | صحبة أجيال' : title;
  document.body.classList.toggle('inner', id !== '');
  Array.prototype.forEach.call(document.querySelectorAll('[data-t]'), function(a){ a.classList.toggle('on', a.getAttribute('data-t') === tab && (tab !== '' || id === '')); });
  window.scrollTo(0,0); reveal();
}
function route(){ if (document.startViewTransition && !RM && curRoute !== null) document.startViewTransition(routeNow); else routeNow(); }
window.addEventListener('hashchange', route);
route();

(function(){ var sp = document.getElementById('splash'), seen = false;
  try { seen = sessionStorage.getItem('sp') === '1'; sessionStorage.setItem('sp','1'); } catch(_){}
  if (seen || RM){ sp.remove(); return; }
  setTimeout(function(){ sp.classList.add('out'); setTimeout(function(){ sp.remove(); }, 700); }, 1400);
})();
%%INSTALL%%
if ('serviceWorker' in navigator && location.protocol === 'https:'){ window.addEventListener('load', function(){ navigator.serviceWorker.register('sw.js').catch(function(){}); }); }
window.__T = { COURSE:COURSE, PAST:PAST, MORE:MORE, VIDEOS:VIDEOS, AW:AW };
})();
</script>
</body>
</html>
